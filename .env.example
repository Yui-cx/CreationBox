ENVIRONMENT=local
JWT_SECRET=replace-with-a-long-random-secret
DAILY_FREE_QUOTA=5
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin

# AI_PROVIDER supports: mock, deepseek, openrouter, openai-compatible.
# Default is DeepSeek. When the selected provider key is empty, the backend falls back to mock for local demo.
AI_PROVIDER=deepseek
AI_API_KEY=

# DeepSeek official API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_TEXT=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_REASONING_EFFORT=high

# OpenRouter switch
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL_TEXT=deepseek/deepseek-v4-flash
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=CreationBox
OPENROUTER_REASONING_ENABLED=false

# Generic OpenAI-compatible fallback
AI_BASE_URL=https://api.deepseek.com
AI_MODEL_TEXT=deepseek-v4-flash

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Image inpainting
INPAINT_LAMA_ENABLED=true
INPAINT_LAMA_PRELOAD=true
INPAINT_LAMA_DEVICE=cpu
INPAINT_LAMA_MAX_IMAGE_BYTES=10485760
INPAINT_LAMA_MAX_PIXELS=4194304
INPAINT_LAMA_CONCURRENCY=1
INPAINT_LAMA_FALLBACK_OPENCV=false
